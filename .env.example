# Local development (default, no external service needed)
STORAGE_DRIVER=sqlite
ESCAPEROOM_DB_PATH=.data/escaperoom.db
# Production (set by Infra Agent on Vercel — never commit real keys)
# STORAGE_DRIVER=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- پنل مدیریت (فاز ۰۹) ---
# نام کاربری مدیر
# ADMIN_USERNAME=admin
# هش SHA-256 گذرواژه (توصیه‌شده در production): printf '%s' 'pass' | sha256sum
# یا هش scrypt با اسکریپت پروژه: npm run hash:admin -- 'گذرواژه'
# هر دو قالب پذیرفته می‌شوند (scrypt$<salt>$<hash> و sha256 هگز).
# ⚠️ در فایل‌های .env، علامت $ باید escape شود (next/dotenv-expand آن را متغیر می‌بیند):
#   ADMIN_PASSWORD_HASH='scrypt\$<salt>\$<hash>'
# در پنل Vercel نیازی به escape نیست؛ مقدار خام را بگذارید.
# ADMIN_PASSWORD_HASH=
# جایگزین فقط برای اجرای محلی؛ در production استفاده نکنید
# ADMIN_PASSWORD=
# نقش: superadmin | moderator | viewer (پیش‌فرض superadmin)
# ADMIN_ROLE=superadmin
# کلید امضای جلسه (الزامی؛ بدون آن ورود ۵۰۳ می‌دهد)
# ADMIN_SESSION_SECRET=
