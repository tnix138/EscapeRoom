#!/bin/sh
# ---------------------------------------------------------------------------
# گارد لاگ تیمی (WORKLOG.md §قانون پوش)
# هر پوش باید حداقل یک فایل در logs/ داشته باشد و همه لاگ‌ها معتبر باشند.
# نصب: npm run worklog:hooks
# دور زدن اضطراری: git push --no-verify
# ---------------------------------------------------------------------------
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  Node.js یافت نشد؛ بررسی لاگ پوش انجام نشد." >&2
  exit 0
fi

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *0000000000000000000000000000000000000000000*) continue ;;
  esac

  if ! node scripts/worklog.mjs check --push "$local_sha" "$remote_sha"; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "✖ پوش متوقف شد: قانون «لاگ به ازای هر پوش» رعایت نشده است." >&2
  echo "   راهنما: WORKLOG.md §قانون پوش — یا git push --no-verify" >&2
  exit 1
fi

exit 0
